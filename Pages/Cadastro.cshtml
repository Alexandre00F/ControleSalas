@page
@model CadastroModel
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Criar conta | Controle de Salas</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body>
    <header class="cabecalho"><div class="container barra"><a class="marca" asp-page="/Login">Controle de Salas</a></div></header>
    <main class="conta painel">
        <span class="etiqueta">COMECE AQUI</span>
        <h1>Crie sua conta.</h1>
        <p>Cadastre-se para reservar uma sala.</p>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="aviso erro" role="alert" asp-validation-summary="All"></div>
        }
        <form method="post">
            <label asp-for="Conta.Nome">Nome</label>
            <input asp-for="Conta.Nome" required minlength="3" autocomplete="name" placeholder="Nome completo">
            <label asp-for="Conta.Email">E-mail</label>
            <input asp-for="Conta.Email" type="email" required autocomplete="email" placeholder="nome@exemplo.com">
            <label asp-for="Conta.Senha">Senha</label>
            <input asp-for="Conta.Senha" type="password" required minlength="8" maxlength="128" autocomplete="new-password" value="">
            <p class="dica">Use pelo menos 8 caracteres.</p>
            <label asp-for="ConfirmarSenha">Confirmar senha</label>
            <input asp-for="ConfirmarSenha" type="password" required minlength="8" maxlength="128" autocomplete="new-password" value="">
            <div class="acoes"><button class="botao" type="submit">Criar minha conta</button></div>
        </form>
        <p class="link-conta">Já tem uma conta? <a asp-page="/Login">Entrar</a></p>
    </main>
</body>
</html>
